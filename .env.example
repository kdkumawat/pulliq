# Optional overrides (defaults work when yt-dlp/ffmpeg are on PATH)
# YT_DLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# EXIFTOOL_PATH=./node_modules/exiftool-vendored.pl/bin/exiftool
# TMP_DIR=/tmp/pulliq
# PORT=3000

# Google Analytics 4 (optional) - get ID from analytics.google.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public site URL (used for keep-alive if RENDER_EXTERNAL_URL is unset)
# NEXT_PUBLIC_SITE_URL=https://pulliq.onrender.com

# In-process keep-alive pings /api/health every 10 min while the server runs.
# Set to false to disable. Render sets RENDER_EXTERNAL_URL automatically.
# KEEP_ALIVE=false
