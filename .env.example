[TEMPLATE]
# Optional overrides (defaults work when yt-dlp/ffmpeg are on PATH,
# or after running: bun run setup:binaries  ->  installs into ./bin)
# YT_DLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# EXIFTOOL_PATH=./node_modules/exiftool-vendored.pl/bin/exiftool
# TMP_DIR=/tmp/pulliq
# PORT=3000

# ---- Extraction tuning ----
# Cookies for locked-in content. Export from a fresh incognito browser session;
# YouTube/SoundCloud/Vimeo often require this from datacenter IPs.
# Either a file path (YT_DLP_COOKIES) or the full cookies.txt content pasted
# as an env var (YT_DLP_COOKIES_CONTENT - handy on Render, no file upload
# needed; it is written to a temp file on first use).
# YT_DLP_COOKIES=/app/cookies.txt
# YT_DLP_COOKIES_CONTENT="# Netscape HTTP Cookie File ..."
# YouTube player clients tried in order. Default works for most cases.
# YT_DLP_PLAYER_CLIENT=default,-android_sdkless
# Max concurrent yt-dlp/ffmpeg processes (default 2, range 1-4).
# Lower it on tiny instances, raise it on beefy ones.
# PULLIQ_PROCESS_LIMIT=2

# Google Analytics 4 - set at least one on Render (GA_MEASUREMENT_ID preferred for Docker)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public site URL (used for keep-alive if RENDER_EXTERNAL_URL is unset)
# NEXT_PUBLIC_SITE_URL=https://pulliq.onrender.com

# In-process keep-alive pings /api/health every 10 min while the server runs.
# Set to false to disable. Render sets RENDER_EXTERNAL_URL automatically.
# KEEP_ALIVE=false
